# RunPod GPU 팟에서 vca-ai + pottery-inspection-ai + backend를 돌리기 위한
# .env 템플릿입니다. .env.example을 베이스로 하되, 로컬 개발과 다른 값만
# 바꿨습니다. 팟에 SSH로 들어가서:
#
#   cp .env.runpod.example .env
#   nano .env   # 아래 TODO 표시된 값들을 채운다
#
# 그다음 scripts/runpod-bootstrap.sh를 실행합니다.

# ============================================================
# RunPod 네트워크 볼륨 - 팟 생성 시 이 경로에 Network Volume을 마운트해야
# 한다(RunPod 콘솔에서 보통 기본값이 /workspace). docker-compose.runpod.yml이
# 모델 캐시/DB 데이터를 여기 밑에 bind mount해서, 팟을 지웠다 새로 만들어도
# Qwen2.5-VL 등 ~11GB 모델을 다시 안 받도록 한다. 다른 경로에 마운트했다면
# 여기를 그 경로로 바꿀 것.
RUNPOD_VOLUME_PATH=/workspace

# ============================================================
# 팟 로컬 스크래치 - vca-ai 파이프라인 중간 산출물(engine-output) 전용.
# 위 네트워크 볼륨과 정반대로 일부러 로컬 디스크에 둔다 - 파일 수천 개짜리
# 스테이지 산출물을 네트워크 볼륨(FUSE 마운트)에서 재귀 스캔하면 실측
# 몇 분씩 걸리는 걸 확인했다. 런이 끝나면 버려도 되는 데이터라 팟을 지우면
# 같이 사라져도 상관없다. 보통 기본값 그대로 둬도 된다.
# ============================================================
RUNPOD_LOCAL_SCRATCH_PATH=/var/lib/vca-local

# ============================================================
# Database - 팟 안에서만 쓰는 로컬 PostgreSQL(local profile)
# ============================================================

COMPOSE_PROFILES=local

POSTGRES_PASSWORD=CHANGE_ME_RANDOM

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/conservation
SPRING_DATASOURCE_USERNAME=conservation
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_RANDOM

# ============================================================
# Authentication / JWT
# ============================================================

JWT_SECRET=CHANGE_ME_RANDOM
JWT_EXPIRATION_MS=86400000

# ============================================================
# OpenAI - 상태조사 문안 생성(conservation-guide-ai, xray report)에만 쓰인다.
# 없어도 vca-ai/pottery-inspection-ai 자체는 동작한다.
# ============================================================

# TODO: 채워야 함
OPENAI_API_KEY=

# ============================================================
# VCA (육안조사) - RunPod GPU에서 실제 모델을 돌리는 설정
# ============================================================

# TODO: 채워야 함 - FE .env의 VITE_VCA_ACCESS_TOKEN과 정확히 같은 값이어야 함
VCA_ACCESS_TOKEN=CHANGE_ME_RANDOM

VCA_RUN_MODE=real
# docker-compose.runpod.yml이 vca-ai 컨테이너에 cuda로 덮어쓰지만, 여기서도
# 명시해 둔다(오버레이 없이 이 파일만 봐도 의도가 보이도록).
VCA_DEVICE=cuda
VCA_MAX_IMAGES=1
VCA_BOOTSTRAP_MODELS=true
VCA_SKIP_VISUAL_CUES=false
VCA_S3_OBJECT_PREFIX=vca/images

# TODO(선택): RAG 문헌 corpus를 쓰려면 채운다. 비워두면 rag 스테이지가
# 참고문헌 없이 돌고, 판정 근거(citation)가 비게 된다 - 데모 품질에 영향.
# 예시 값: https://drive.google.com/file/d/xxxxxxxx/view?usp=sharing
VCA_RAG_CORPUS_ARCHIVE_URL=

# ============================================================
# AWS / S3 - RunPod 팟 안 MinIO를 S3 대역으로 쓴다(local profile).
# ============================================================

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=runpod-minio-admin
AWS_SECRET_ACCESS_KEY=CHANGE_ME_RANDOM
AWS_S3_BUCKET=conservation-local

# 컨테이너 사이(Spring -> MinIO) 통신용 - 내부 도커 네트워크 호스트명 그대로 둔다.
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_PATH_STYLE_ACCESS_ENABLED=true

# TODO: 중요 - presigned URL은 브라우저(FE)가 직접 호출하므로 내부 호스트명
# "minio"로 주면 FE에서 못 찾는다. RunPod 팟의 외부 접속 주소로 바꿔야 한다
# (RunPod 콘솔의 Connect 탭에서 9000번 포트에 매핑된 프록시 URL 또는
# <public-ip>:9000). 아래 예시를 실제 값으로 바꿀 것.
AWS_S3_PRESIGN_ENDPOINT=https://REPLACE-WITH-RUNPOD-9000-PROXY-URL

# ============================================================
# X-RAY Stitch Callback - 이번 시연 범위 밖이지만 backend가 기동하려면
# 변수 자체는 있어야 한다(비워도 무방).
# ============================================================

XRAY_STITCH_CALLBACK_TOKEN=

# ============================================================
# CORS - FE가 RunPod 프록시 도메인(예: https://<pod-id>-5173.proxy.runpod.net)
# 에서 뜨기 때문에 기본값(localhost:5173 등)으로는 Spring이 막는다.
# ============================================================

# TODO: 중요 - FE를 실제로 여는 주소로 바꿀 것(콤마로 여러 개 가능)
APP_CORS_ALLOWED_ORIGINS=https://REPLACE-WITH-RUNPOD-5173-PROXY-URL
