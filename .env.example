# ============================================================
# Database - Local Docker PostgreSQL
# ============================================================

POSTGRES_PASSWORD=postgres

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/conservation
SPRING_DATASOURCE_USERNAME=conservation
SPRING_DATASOURCE_PASSWORD=postgres

# ============================================================
# Authentication / JWT
# ============================================================

JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ============================================================
# OpenAI
# ============================================================

OPENAI_API_KEY=

# ============================================================
# VCA (육안조사)
# ============================================================

VCA_ACCESS_TOKEN=local-vca-token
VCA_RUN_MODE=real
VCA_DEVICE=auto
VCA_MAX_IMAGES=1
VCA_BOOTSTRAP_MODELS=true
VCA_SKIP_VISUAL_CUES=false
VCA_S3_OBJECT_PREFIX=vca/images

# Only needed if you run with docker-compose.local-vca.override.yml (native
# vca-ai on macOS, since Docker Desktop doesn't pass through Apple GPU/MPS
# acceleration) - absolute path to your local vca_v2 checkout. Left unset,
# Compose silently substitutes an empty string and the override's bind
# mounts point at the wrong path.
# VCA_V2_LOCAL_ENGINE_ROOT=/absolute/path/to/vca_v2

# ============================================================
# AWS / S3
# ============================================================

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin-vca-20260805
AWS_S3_BUCKET=conservation-local
# Local MinIO stand-in for S3 - not used against real AWS. Leave unset when
# pointing AWS_* at a real bucket/region.
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_PRESIGN_ENDPOINT=http://localhost:9000
AWS_S3_PATH_STYLE_ACCESS_ENABLED=true

# ============================================================
# X-RAY Stitch Callback
# ============================================================

XRAY_STITCH_CALLBACK_TOKEN=
