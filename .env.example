# ============================================================
# Database - Local Docker PostgreSQL
# ============================================================

POSTGRES_PASSWORD=change_me

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/conservation
SPRING_DATASOURCE_USERNAME=conservation
SPRING_DATASOURCE_PASSWORD=change_me

# ============================================================
# Authentication / JWT
# ============================================================

JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ============================================================
# OpenAI
# ============================================================

OPENAI_API_KEY=

# ============================================================
# VCA (육안조사)
# ============================================================

# /api/vca/** 전체를 보호하는 유일한 인증 토큰(WebSecurityConfig의
# anyRequest().permitAll()에 걸려 이 경로들은 JWT 검사가 없다) - 없으면
# Spring이 기동 시점에 바로 실패한다. vca-ai가 아니라 FE와 맞춰야 하는 값:
# cultural-heritage-fe/.env의 VITE_VCA_ACCESS_TOKEN과 정확히 같아야 한다
# (X-VCA-Access-Token 헤더로 보냄).
VCA_ACCESS_TOKEN=change_me

# BE -> vca-ai 호출에 실어 보내는 별개의 토큰(같은 X-VCA-Access-Token 헤더
# 이름을 재사용하지만 위 VCA_ACCESS_TOKEN과는 값이 다르다 - 혼동 주의).
# VCA는 GPU가 필요한 무거운 파이프라인이라 클러스터 밖 별도 GPU
# 호스트(RunPod 등)에 위탁해서 돌릴 수 있는데, 그렇게 공개 노출된
# 경우에만 이 토큰이 실질적 의미가 있다 - 같은 클러스터 안에서만 닿을 수
# 있으면 비워둬도 된다(vca-ai 쪽도 비어있으면 검증을 건너뜀).
VCA_AI_ACCESS_TOKEN=

# vca-ai가 지금 어디서 돌고 있는지. 모든 환경(로컬 docker-compose, k8s의
# app-secrets)이 이 이름을 그대로 쓴다 - 값만 그 환경에 맞게 바꾸면 된다.
#   기본(docker-compose.yml 단독, vca-ai를 같은 compose로 띄움): http://vca-ai:8000
#   docker-compose.local-vca.override.yml(같은 맥북 bare 프로세스): http://host.docker.internal:8000
#   docker-compose.remote-vca.override.yml(RunPod 등 원격 위탁): 그 호스트의 공개 주소, 필수값
#   k8s(app-secrets): 위와 동일한 기준, k8s/app.yaml이 secretKeyRef로 읽음
# (git 커밋 없이 값만 갱신하면 반영되므로, 외부 GPU 호스트가 재배정돼
# 주소가 바뀌거나 내부/외부 모드를 전환할 때도 이 값만 바꾸면 된다.)
VCA_AI_BASE_URL=http://vca-ai:8000

# vca-ai를 RunPod 등 원격에 위탁할 때만 쓴다(docker-compose.remote-vca.override.yml
# 전용) - MinIO도 그 호스트에서 같이 뜨므로, BE가 이 주소로 presigned URL을
# 만들어야 vca-ai가 같은 호스트에서 그 URL을 열 수 있다. 실제 AWS S3를 쓰는
# 환경(k8s+RDS/S3 배포)에서는 필요 없다 - S3 presigned URL은 원래 공개
# 인터넷 어디서나 열리는 정상 HTTPS URL이기 때문.
VCA_S3_REMOTE_BASE_URL=

VCA_RUN_MODE=real
VCA_DEVICE=auto
VCA_MAX_IMAGES=1
VCA_BOOTSTRAP_MODELS=true
VCA_SKIP_VISUAL_CUES=false
VCA_S3_OBJECT_PREFIX=vca/images

# 최초 기동 시(또는 named volume 초기화 후) models/rag/ 캐시가 로컬에 없으면
# vca-entrypoint.sh가 이 값의 Google Drive 공유 링크에서 zip을 받아 자동으로
# 푼다. 이미 채워져 있으면 다시 받지 않는다(명시적 갱신만 함, 원본 PDF 변경을
# 자동으로 감지하지 않음).
# 예시 값: https://drive.google.com/file/d/1nkYrHJq8NKfGHVPp8xI40YdjkcwC3htM/view?usp=sharing
VCA_RAG_CORPUS_ARCHIVE_URL=

# macOS에서 Docker Desktop이 Apple GPU/MPS를 컨테이너로 넘기지 못해
# docker-compose.local-vca.override.yml로 vca-ai를 네이티브 실행할 때만
# 필요하다. 비워두면(기본) Compose가 빈 문자열로 치환해 이 override
# 파일의 바인드 마운트가 잘못된 경로를 가리키게 되니, 그 override를 안
# 쓰면 그냥 비워둔다.
# VCA_V2_LOCAL_ENGINE_ROOT=/absolute/path/to/vca_v2

# ============================================================
# AWS / S3
# ============================================================

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ============================================================
# X-RAY Stitch Callback
# ============================================================

XRAY_STITCH_CALLBACK_TOKEN=
