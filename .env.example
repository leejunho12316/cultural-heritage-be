# Local Docker Compose
POSTGRES_PASSWORD=change-me
OPENAI_API_KEY=

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-xray-bucket
# Optional locally. Leave blank on EC2/ECS/EKS when using an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Use the same random value in Spring and FastAPI callback requests.
XRAY_STITCH_CALLBACK_TOKEN=change-me-to-a-long-random-value
